{
  "name": "uniccmeet",
  "version": "0.1.9",
  "desktopName": "com.uniccmeet.desktop.desktop",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "prepare:desktop": "node scripts/prepare-desktop-config.mjs",
    "release:validate": "node scripts/validate-release-env.mjs",
    "lint": "eslint src/pages --max-warnings 0 && eslint src/components src/helpers src/store src/index.tsx src/vite-env.d.ts --max-warnings 0 && eslint electron scripts electron-builder.config.cjs vite.config.ts eslint.config.js --max-warnings 0 && pnpm typecheck",
    "typecheck": "tsc --noEmit",
    "electron": "pnpm prepare:desktop && && electron .",
    "dist:win:x64": "pnpm prepare:desktop && electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
    "dist:mac:x64": "pnpm prepare:desktop && electron-builder --config electron-builder.config.cjs --mac dmg zip --x64 --publish never",
    "dist:mac:arm64": "pnpm prepare:desktop && electron-builder --config electron-builder.config.cjs --mac dmg zip --arm64 --publish never",
    "dist:linux:x64": "pnpm prepare:desktop && electron-builder --config electron-builder.config.cjs --linux AppImage deb rpm --x64 --publish never",
    "dist:linux:arm64": "pnpm prepare:desktop && electron-builder --config electron-builder.config.cjs --linux AppImage deb rpm --arm64 --publish never"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.0",
    "redux-persist": "^6.0.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "build": {
    "appId": "com.uniccmeet.desktop",
    "productName": "多媒体高清AI会议平台",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "build/app-icon.png",
        "to": "app-icon.png"
      },
      {
        "from": "build/desktop-config.json",
        "to": "desktop-config.json"
      }
    ],
    "win": {
      "icon": "build/app-icon.png",
      "artifactName": "uniccmeet-${version}-windows-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/app-icon.png",
      "artifactName": "uniccmeet-${version}-macos-${arch}.${ext}",
      "category": "public.app-category.business",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "hardenedRuntime": true,
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "CFBundleDisplayName": "多媒体高清AI会议平台",
        "CFBundleName": "多媒体高清AI会议平台",
        "NSCameraUsageDescription": "用于在会议中开启摄像头",
        "NSMicrophoneUsageDescription": "用于在会议中使用麦克风",
        "NSScreenCaptureUsageDescription": "用于在会议中共享屏幕"
      }
    },
    "linux": {
      "icon": "build/icons",
      "artifactName": "uniccmeet-${version}-linux-${arch}.${ext}",
      "category": "Network",
      "executableName": "uniccmeet",
      "syncDesktopName": true,
      "maintainer": "UNICCMeet Team",
      "vendor": "UNICCMeet",
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ]
    },
    "deb": {
      "afterInstall": "build/after-install.sh",
      "recommends": [
        "libappindicator3-1",
        "pipewire",
        "xdg-desktop-portal",
        "xdg-desktop-portal-gtk | xdg-desktop-portal-gnome | xdg-desktop-portal-kde"
      ]
    },
    "rpm": {
      "afterInstall": "build/after-install.sh"
    },
    "generateUpdatesFilesForAllChannels": true,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
